.hud {
    position: absolute;
    left: 24px;
    top: 24px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0.4);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.hud__label {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding-top: 2px;
    padding-bottom: 2px;
}
